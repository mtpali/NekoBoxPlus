+    override fun dispatchTouchEvent(event: MotionEvent): Boolean {
+        val fragment = supportFragmentManager.findFragmentById(R.id.fragment_holder)
+        val home = fragment is MobileTinaHomeFragment || fragment is ConfigurationFragment
+        val canSwipe = home && !SagerNet.isTv && !shellState.drawerIsOpen && !shellState.drawerRequestedOpen &&
+            (fragment !is ConfigurationFragment || fragment.canSwipeMobileTinaMode)
+        when (event.actionMasked) {
+            MotionEvent.ACTION_DOWN -> {
+                modeSwipeStartX = event.x
+                modeSwipeStartY = event.y
+                val edge = MobileTinaHomeChrome.dp(this, 24)
+                modeSwipeEligible = canSwipe && event.x > edge && event.x < resources.displayMetrics.widthPixels - edge
+            }
+            MotionEvent.ACTION_POINTER_DOWN, MotionEvent.ACTION_CANCEL -> modeSwipeEligible = false
+            MotionEvent.ACTION_UP -> {
+                val dx = event.x - modeSwipeStartX
+                val dy = event.y - modeSwipeStartY
+                if (modeSwipeEligible && canSwipe && kotlin.math.abs(dx) >= MobileTinaHomeChrome.dp(this, 84) &&
+                    kotlin.math.abs(dx) > kotlin.math.abs(dy) * 1.35f) {
+                    modeSwipeEligible = false
+                    val target = if (dx < 0) R.id.nav_mobiletina else R.id.nav_configuration
+                    val changesMode = (target == R.id.nav_mobiletina && fragment !is MobileTinaHomeFragment) ||
+                        (target == R.id.nav_configuration && fragment !is ConfigurationFragment)
+                    if (changesMode && !supportFragmentManager.isStateSaved) {
+                        val cancel = MotionEvent.obtain(event).apply { action = MotionEvent.ACTION_CANCEL }
+                        super.dispatchTouchEvent(cancel)
+                        cancel.recycle()
+                        displayFragmentWithId(target)
+                        return true
+                    }
+                }
+                modeSwipeEligible = false
+            }
+        }
+        return super.dispatchTouchEvent(event)
+    }
