@@ -43,4 +43,41 @@ class AppSelectionLogicTest {
 
         assertEquals(listOf("system.app", "one.app", "shared.first", "shared.second"), sorted.map { it.packageName })
     }
+
+    @Test
+    fun requestedAppsStayAboveOtherSelectedApps() {
+        val priority = listOf("com.whatsapp", "com.instagram.android", "org.telegram.messenger",
+            "com.android.chrome", "com.google.android.googlequicksearchbox")
+        val installed = priority.reversed().mapIndexed { index, name ->
+            SelectableApp(name, name, uid = 2000 + index, isSystem = true)
+        } + apps
+        val sorted = AppSelectionLogic.sort(installed, setOf(1001, 1003))
+
+        assertEquals(priority, sorted.take(priority.size).map { it.packageName })
+        assertEquals(installed.size, sorted.size)
+    }
+
+    @Test
+    fun chromeAndGoogleSearchRemainVisibleWhenTheyAreSystemApps() {
+        val installed = listOf(
+            SelectableApp("com.android.chrome", "Chrome", 2001, isSystem = true),
+            SelectableApp("com.google.android.googlequicksearchbox", "Google", 2002, isSystem = true),
+        ) + apps
+        val visible = AppSelectionLogic.filter(installed, "", showSystemApps = false)
+
+        assertTrue(visible.any { it.packageName == "com.android.chrome" })
+        assertTrue(visible.any { it.packageName == "com.google.android.googlequicksearchbox" })
+        assertFalse(visible.any { it.packageName == "system.app" })
+    }
+
+    @Test
+    fun priorityAppsStillRespectTheSearchQuery() {
+        val installed = listOf(
+            SelectableApp("com.android.chrome", "Chrome", 2001, isSystem = true),
+            SelectableApp("com.whatsapp", "WhatsApp", 2002, isSystem = false),
+        )
+        assertEquals(listOf("com.android.chrome"),
+            AppSelectionLogic.filter(installed, "chrome", false).map { it.packageName })
+        assertTrue(AppSelectionLogic.filter(installed, "not installed", false).isEmpty())
+    }
 }
