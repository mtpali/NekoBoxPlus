<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:layoutDirection="ltr" android:background="?attr/colorSurface">
    <include layout="@layout/mobiletina_home_header" />
    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/mobiletina_auto_refresh"
        android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
        <androidx.core.widget.NestedScrollView android:id="@+id/auto_panel"
            android:layout_width="match_parent" android:layout_height="match_parent"
            android:fillViewport="true" android:overScrollMode="never" android:clipToPadding="false">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:gravity="center_horizontal" android:orientation="vertical"
                android:paddingStart="18dp" android:paddingTop="24dp" android:paddingEnd="18dp" android:paddingBottom="24dp">
                <com.google.android.material.imageview.ShapeableImageView android:id="@+id/fab_auto"
                    android:layout_width="236dp" android:layout_height="236dp"
                    android:background="@android:color/transparent" android:clickable="true"
                    android:contentDescription="@string/mobiletina_connect_action" android:focusable="true"
                    android:scaleType="fitCenter" android:src="@android:color/transparent"
                    app:shapeAppearanceOverlay="@style/MobileTinaCircleFab" />
                <TextView android:id="@+id/tv_auto_status" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginTop="18dp" android:gravity="center" android:text="@string/mobiletina_status_disconnected"
                    android:textAppearance="@style/TextAppearance.AppCompat.Title" android:textStyle="bold" />
                <TextView android:id="@+id/tv_auto_message" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="8dp" android:gravity="center" android:textSize="14sp"
                    android:textColor="?attr/colorError" android:visibility="gone" />
                <TextView android:id="@+id/tv_auto_server" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="12dp" android:ellipsize="end" android:gravity="center" android:maxLines="2"
                    android:textColor="@color/mobiletina_status_secondary" android:textSize="15sp" android:textStyle="bold" />
                <TextView android:id="@+id/tv_auto_ping" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginTop="6dp" android:background="?attr/selectableItemBackgroundBorderless"
                    android:clickable="true" android:contentDescription="@string/mobiletina_ping_tap" android:focusable="true"
                    android:gravity="center" android:minHeight="40dp" android:paddingHorizontal="18dp" android:paddingVertical="5dp"
                    android:textColor="@color/mobiletina_status_secondary" android:textStyle="bold" android:visibility="gone" />
                <com.google.android.material.card.MaterialCardView android:id="@+id/subscription_card"
                    android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="24dp"
                    app:cardBackgroundColor="@color/mobiletina_usage_surface" app:cardCornerRadius="22dp"
                    app:cardElevation="0dp" app:strokeColor="@color/mobiletina_usage_stroke" app:strokeWidth="1dp"
                    android:visibility="gone">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="vertical" android:padding="20dp">
                        <TextView android:id="@+id/tv_subscription_name" android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:gravity="center" android:text="@string/mobiletina_usage_brand" android:textDirection="ltr"
                            android:textColor="@color/mobiletina_usage_accent" android:textSize="14sp" android:textStyle="bold" />
                        <TextView android:id="@+id/tv_subscription_group" android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:layout_marginTop="6dp" android:gravity="center" android:maxLines="1" android:ellipsize="end"
                            android:textColor="@color/mobiletina_secondary" android:textSize="12sp" />
                        <TextView android:id="@+id/tv_subscription_remaining_label" android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:layout_marginTop="18dp" android:gravity="center" android:text="@string/mobiletina_usage_remaining"
                            android:textColor="@color/mobiletina_secondary" android:textSize="12sp" />
                        <TextView android:id="@+id/tv_subscription_remaining" android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:layout_marginTop="5dp" android:gravity="center" android:maxLines="2" android:textDirection="locale"
                            android:textColor="@color/mobiletina_primary_content" android:textSize="20sp" android:textStyle="bold" />
                        <com.google.android.material.progressindicator.LinearProgressIndicator android:id="@+id/subscription_progress"
                            android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp"
                            android:max="100" app:indicatorColor="@color/mobiletina_usage_accent"
                            app:trackColor="@color/mobiletina_usage_stroke" app:trackCornerRadius="4dp" app:trackThickness="6dp" />
                        <TextView android:id="@+id/tv_subscription_traffic" android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:layout_marginTop="12dp" android:gravity="center" android:textDirection="locale"
                            android:textColor="@color/mobiletina_secondary" android:textSize="12sp" />
                        <TextView android:id="@+id/tv_subscription_days" android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:layout_marginTop="12dp" android:gravity="center"
                            android:textColor="@color/mobiletina_usage_accent" android:textSize="13sp" android:textStyle="bold" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
</LinearLayout>
